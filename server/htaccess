# Роутинг сайта Delomant Analytics. Доступ закрыт формой входа (index.php),
# статика приложения отдаётся asset.php по сессии. Basic Auth больше не
# используется — защита целиком на стороне PHP.

RewriteEngine On

# Точки входа отдаём как есть
RewriteRule ^(index|asset|setup|comtrade|wits|admin)\.php$ - [L]

# Пути, к которым обращается фронтенд, проксируем на asset.php.
# Проверку сессии делает сам asset.php.
RewriteRule ^styles/main\.css$              asset.php?f=css  [L]
RewriteRule ^scripts/main\.js$              asset.php?f=js   [L]
RewriteRule ^data/Logo\.png$                asset.php?f=logo [L]
RewriteRule ^data/cbr_rates\.json$          asset.php?f=cbr  [L]
RewriteRule ^data/company_dictionary\.json$ asset.php?f=dict [L]
RewriteRule ^data/comtrade_countries\.json$ asset.php?f=ctry [L]
RewriteRule ^data/comtrade_regions\.json$   asset.php?f=creg [L]
RewriteRule ^data/wits_countries\.json$     asset.php?f=wits [L]
RewriteRule ^data/wits_regions\.json$       asset.php?f=witsreg [L]
RewriteRule ^scripts/foreign_customs\.js$    asset.php?f=fcjs [L]
RewriteRule ^data/foreign/hs_names_ru\.json$ asset.php?f=fchs [L]
RewriteRule ^data/foreign/co_aggregate\.json$ asset.php?f=fcco [L]
RewriteRule ^data/foreign/pe_aggregate\.json$ asset.php?f=fcpe [L]
RewriteRule ^data/foreign/kz_aggregate\.json$ asset.php?f=fckz [L]
RewriteRule ^data/foreign/kg_aggregate\.json$ asset.php?f=fckg [L]
RewriteRule ^data/foreign/kg_series\.json$    asset.php?f=fckgs [L]
RewriteRule ^data/foreign/kz_series\.json$    asset.php?f=fckzs [L]
RewriteRule ^data/foreign/kz_dynamic\.json$   asset.php?f=fckzd [L]

# Корень сайта → форма входа / приложение
RewriteRule ^$ index.php [L]

# Прямой доступ к внутренностям запрещён (nginx .dat не перехватывает,
# поэтому запрос доходит до Apache и получает 403)
RewriteRule ^(app|assets|cache)(/|$) - [F]

# Хеш пароля и ключ подписки Comtrade недоступны снаружи в любом случае
<FilesMatch "^(config|comtrade_key|users)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.dat$">
    Require all denied
</FilesMatch>
